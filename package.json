{
  "name": "slack2mail",
  "type": "module",
  "private": true,
  "scripts": {
    "build": "NODE_OPTIONS=--max-old-space-size=8192 nuxt build",
    "dev": "HOST=0.0.0.0 nuxt dev --dotenv .env.local",
    "deploy": "NODE_OPTIONS=--max-old-space-size=8192 nuxt build && wrangler deploy",
    "envdeploy": "wrangler secret bulk .env",
    "generate": "nuxt generate",
    "preview": "nuxt preview",
    "postinstall": "nuxt prepare",
    "tail": "wrangler tail",
    "test": "vitest",
    "test:watch": "vitest --watch",
    "test:coverage": "vitest --coverage",
    "test:unit": "vitest --project unit",
    "test:nuxt": "vitest --project nuxt"
  },
  "dependencies": {
    "@mdi/font": "^7.4.47",
    "@nuxtjs/supabase": "^2.0.9",
    "@slack/web-api": "^7.17.0",
    "@supabase/supabase-js": "^2.108.2",
    "googleapis": "^173.0.0",
    "imapflow": "^1.4.3",
    "luxon": "^3.7.2",
    "mailparser": "^3.9.14",
    "nodemailer": "^9.0.1",
    "nuxt": "^4.4.8",
    "ulid": "^3.0.2",
    "xlsx": "^0.18.5"
  },
  "devDependencies": {
    "@nuxt/test-utils": "^4.0.3",
    "@slack/types": "^3.1.0",
    "@types/luxon": "^3.7.2",
    "@types/mailparser": "^3.4.6",
    "@types/node": "^26.1.2",
    "@types/nodemailer": "^8.0.1",
    "@vitest/coverage-v8": "^4.1.10",
    "@vue/test-utils": "^2.4.11",
    "dotenv-expand": "^1000.0.0",
    "happy-dom": "^20.10.6",
    "nuxt-qrcode": "^0.4.10",
    "supabase": "^2.110.0",
    "tsx": "^4.23.4",
    "vite-plugin-vuetify": "^2.1.3",
    "vitest": "^4.1.10",
    "vuetify": "^4.1.2"
  },
  "allowScripts": {
    "@parcel/watcher@2.5.6": true,
    "esbuild@0.28.1": true,
    "esbuild@0.28.2": true,
    "workerd@1.20260828.1": true
  }
}
